{
  "name": "scaffold-agent-specs",
  "version": "0.1.7",
  "description": "A tiny, spec-driven workflow scaffold for AI coding agents",
  "type": "module",
  "license": "MIT",
  "bin": {
    "scaffold-agent-specs": "bin/scaffold-agent-specs.js"
  },
  "files": [
    "bin/",
    "lib/",
    "scaffold/",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "pack:check": "npm pack --dry-run",
    "format": "npx --yes prettier@3 --write \"scaffold/**/*.md\"",
    "format:check": "npx --yes prettier@3 --check \"scaffold/**/*.md\"",
    "fingerprints": "node scripts/record-fingerprints.js"
  },
  "keywords": [
    "agents",
    "agentic-coding",
    "spec-driven-development",
    "scaffolding",
    "claude-code",
    "codex"
  ],
  "author": "rob-pasc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rob-pasc/scaffold-agent-specs.git"
  },
  "homepage": "https://github.com/rob-pasc/scaffold-agent-specs#readme",
  "bugs": {
    "url": "https://github.com/rob-pasc/scaffold-agent-specs/issues"
  }
}
