{
  "name": "scaffold-agent-specs",
  "version": "0.4.5",
  "description": "Dependency-free CLI that installs agent instructions and an approval-gated, spec-driven feature workflow into any repository",
  "type": "module",
  "license": "MIT",
  "bin": {
    "scaffold-agent-specs": "bin/scaffold-agent-specs.js"
  },
  "files": [
    "bin/",
    "lib/",
    "scaffold/",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "pack:check": "node scripts/release.js pack --dry-run",
    "release:pack": "node scripts/release.js pack",
    "release:publish": "node scripts/release.js publish",
    "format": "npx --yes prettier@3 --write \"scaffold/**/*.md\"",
    "format:check": "npx --yes prettier@3 --check \"scaffold/**/*.md\"",
    "fingerprints": "node scripts/record-fingerprints.js"
  },
  "keywords": [
    "agents",
    "agentic-coding",
    "spec-driven-development",
    "scaffolding",
    "claude-code",
    "codex",
    "agents-md",
    "workflow"
  ],
  "author": "rob-pasc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rob-pasc/scaffold-agent-specs.git"
  },
  "homepage": "https://github.com/rob-pasc/scaffold-agent-specs#readme",
  "bugs": {
    "url": "https://github.com/rob-pasc/scaffold-agent-specs/issues"
  }
}
